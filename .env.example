# Either one URL...
DATABASE_URL="mysql://root:password@localhost:3306/expense_tracker"
# ...or separate values (used when DATABASE_URL is not set), e.g. on Vercel:
# DB_HOST=""
# DB_PORT="3306"
# DB_NAME=""
# DB_USER=""
# DB_PASSWORD=""
SESSION_SECRET="change-me-to-a-long-random-string-32+chars"

# Optional AI (server-side only; never exposed to the browser)
ANTHROPIC_API_KEY=""
# claude-opus-5-5 by default; set a cheaper model for high volume
AI_MODEL=""
# "none" disables AI entirely
AI_PROVIDER=""

# Push alerts for new debits/credits. Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
