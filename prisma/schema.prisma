generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

enum AccountType {
  BANK
  SAVINGS
  CREDIT_CARD
  CASH
  WALLET
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  REFUND
  CARD_PAYMENT
  ADJUSTMENT
}

enum TransactionSource {
  MANUAL
  SMS
  EMAIL
  IMPORT
  SHORTCUT
}

enum ProcessingStatus {
  CONFIRMED
  NEEDS_REVIEW
  REJECTED
}

enum CategoryType {
  EXPENSE
  INCOME
  TRANSFER
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum Frequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurringStatus {
  SUGGESTED
  ACTIVE
  PAUSED
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

model User {
  id                String   @id @default(uuid()) @db.VarChar(36)
  name              String   @db.VarChar(120)
  email             String   @unique @db.VarChar(190)
  passwordHash      String   @map("password_hash") @db.VarChar(100)
  preferredCurrency String   @default("AED") @map("preferred_currency") @db.VarChar(3)
  timezone          String   @default("Asia/Dubai") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  accounts       Account[]
  transactions   Transaction[]
  categories     Category[]
  merchantRules  MerchantRule[]
  budgets        Budget[]
  recurring      RecurringTransaction[]
  messageImports MessageImport[]
  notifications  Notification[]
  devices        Device[]
  insights       AiInsight[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Account {
  id              String      @id @default(uuid()) @db.VarChar(36)
  userId          String      @map("user_id") @db.VarChar(36)
  name            String      @map("account_name") @db.VarChar(120)
  bankName        String?     @map("bank_name") @db.VarChar(120)
  type            AccountType @map("account_type")
  currency        String      @db.VarChar(3)
  openingBalance  Decimal     @default(0) @map("opening_balance") @db.Decimal(18, 2)
  creditLimit     Decimal?    @map("credit_limit") @db.Decimal(18, 2)
  maskedReference String?     @map("masked_reference") @db.VarChar(20)
  dueDay          Int?        @map("due_day")
  minPayment      Decimal?    @map("min_payment") @db.Decimal(18, 2)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]          @relation("TxAccount")
  incoming     Transaction[]          @relation("TxTransferTo")
  recurring    RecurringTransaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id               String       @id @default(uuid()) @db.VarChar(36)
  userId           String?      @map("user_id") @db.VarChar(36)
  parentCategoryId String?      @map("parent_category_id") @db.VarChar(36)
  name             String       @db.VarChar(80)
  icon             String?      @db.VarChar(40)
  color            String?      @db.VarChar(9)
  type             CategoryType @default(EXPENSE) @map("category_type")

  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?      @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children     Category[]     @relation("CategoryTree")
  transactions Transaction[]
  merchants    Merchant[]
  rules        MerchantRule[]
  budgets      Budget[]

  @@unique([userId, name])
  @@index([parentCategoryId])
  @@map("categories")
}

model Merchant {
  id                String  @id @default(uuid()) @db.VarChar(36)
  normalizedName    String  @unique @map("normalized_name") @db.VarChar(120)
  displayName       String  @map("display_name") @db.VarChar(120)
  defaultCategoryId String? @map("default_category_id") @db.VarChar(36)

  defaultCategory Category?              @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  transactions    Transaction[]
  recurring       RecurringTransaction[]

  @@map("merchants")
}

model MerchantRule {
  id              String  @id @default(uuid()) @db.VarChar(36)
  userId          String  @map("user_id") @db.VarChar(36)
  merchantPattern String  @map("merchant_pattern") @db.VarChar(120)
  categoryId      String  @map("category_id") @db.VarChar(36)
  priority        Int     @default(100)
  enabled         Boolean @default(true)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, enabled, priority])
  @@map("merchant_rules")
}

model Transaction {
  id                String            @id @default(uuid()) @db.VarChar(36)
  userId            String            @map("user_id") @db.VarChar(36)
  accountId         String?           @map("account_id") @db.VarChar(36)
  toAccountId       String?           @map("to_account_id") @db.VarChar(36)
  categoryId        String?           @map("category_id") @db.VarChar(36)
  merchantId        String?           @map("merchant_id") @db.VarChar(36)
  amount            Decimal           @db.Decimal(18, 2)
  currency          String            @db.VarChar(3)
  type              TransactionType   @map("transaction_type")
  date              DateTime          @map("transaction_date")
  description       String?           @db.VarChar(500)
  notes             String?           @db.VarChar(500)
  source            TransactionSource @default(MANUAL)
  externalReference String?           @map("external_reference") @db.VarChar(120)
  fingerprint       String?           @db.VarChar(64)
  idempotencyKey    String?           @map("idempotency_key") @db.VarChar(64)
  status            ProcessingStatus  @default(CONFIRMED) @map("processing_status")
  confidence        Decimal?          @db.Decimal(4, 3)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account?  @relation("TxAccount", fields: [accountId], references: [id], onDelete: SetNull)
  toAccount Account?  @relation("TxTransferTo", fields: [toAccountId], references: [id], onDelete: SetNull)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  merchant  Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, date])
  @@index([userId, categoryId, date])
  @@index([userId, fingerprint])
  @@index([accountId])
  @@map("transactions")
}

model Budget {
  id         String       @id @default(uuid()) @db.VarChar(36)
  userId     String       @map("user_id") @db.VarChar(36)
  categoryId String?      @map("category_id") @db.VarChar(36)
  amount     Decimal      @db.Decimal(18, 2)
  currency   String       @db.VarChar(3)
  period     BudgetPeriod
  startDate  DateTime     @map("start_date")
  endDate    DateTime?    @map("end_date")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, period])
  @@map("budgets")
}

model RecurringTransaction {
  id          String          @id @default(uuid()) @db.VarChar(36)
  userId      String          @map("user_id") @db.VarChar(36)
  accountId   String?         @map("account_id") @db.VarChar(36)
  merchantId  String?         @map("merchant_id") @db.VarChar(36)
  name        String          @default("") @db.VarChar(120)
  category    String          @default("Other") @db.VarChar(80)
  currency    String          @default("AED") @db.VarChar(3)
  amount      Decimal         @db.Decimal(18, 2)
  frequency   Frequency
  nextDueDate DateTime        @map("next_due_date")
  status      RecurringStatus @default(SUGGESTED)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("recurring_transactions")
}

model MessageImport {
  id                  String            @id @default(uuid()) @db.VarChar(36)
  userId              String            @map("user_id") @db.VarChar(36)
  source              TransactionSource
  sourceReference     String?           @map("source_reference") @db.VarChar(120)
  encryptedMessage    String            @map("encrypted_message") @db.Text
  status              ProcessingStatus  @default(NEEDS_REVIEW) @map("processing_status")
  parsedTransactionId String?           @map("parsed_transaction_id") @db.VarChar(36)
  receivedAt          DateTime          @map("received_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceReference])
  @@index([userId, status])
  @@map("message_imports")
}

model Notification {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(160)
  message   String    @db.VarChar(500)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model Device {
  id         String       @id @default(uuid()) @db.VarChar(36)
  userId     String       @map("user_id") @db.VarChar(36)
  name       String       @map("device_name") @db.VarChar(120)
  platform   String       @db.VarChar(20)
  tokenHash  String       @unique @map("token_hash") @db.VarChar(64)
  lastSyncAt DateTime?    @map("last_sync_at")
  status     DeviceStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model AiInsight {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  type        String   @map("insight_type") @db.VarChar(40)
  title       String   @db.VarChar(160)
  description String   @db.Text
  generatedAt DateTime @default(now()) @map("generated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
  @@map("ai_insights")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String?  @map("user_id") @db.VarChar(36)
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.VarChar(36)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}
